<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.quis.intelligence.calendar</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/quis/Intelligence Framework/scripts/scheduled_calendar.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key><string>America/Los_Angeles</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>12</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key><string>/Users/quis/Intelligence Framework/logs/launchd_calendar.out</string>
    <key>StandardErrorPath</key><string>/Users/quis/Intelligence Framework/logs/launchd_calendar.err</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
